{
  "_nuke_bridge": {
    "description": "NukeBridge ALL-IN-ONE (sequence). One EXR per frame: N = Sapiens2 on person + head crops, MoGe elsewhere, stabilized with optical flow | depth.Z = Video Depth Anything metric (stable, metres) | P = depth.Z + MoGe camera (fixed FOV) | A = LTX-2.5 Alpha Gen matte (or Sapiens2 segmentation, faster).",
    "name": "A, N, Z, P",
    "chunk": 25,
    "overlap": 2,
    "params": {
      "fov_x_degrees (0 = auto)": [
        "3",
        "fov_x_degrees"
      ],
      "MoGe resolution_level": [
        "3",
        "resolution_level"
      ],
      "N stabilize radius (frames each side, 0 = off)": [
        "11",
        "stabilize_radius"
      ],
      "N stabilize sigma (lower = fewer ghosts)": [
        "11",
        "stabilize_sigma"
      ],
      "N anti-ghost max angle (deg, 0 = off)": [
        "11",
        "stabilize_max_angle"
      ],
      "VDA max_res": [
        "6",
        "max_res"
      ],
      "Sapiens normal size": [
        "9",
        "model_size"
      ],
      "Sapiens head pass (sharper faces)": [
        "10",
        "head_pass"
      ],
      "Sapiens crop padding": [
        "10",
        "padding"
      ],
      "write comparison layers (Nraw, Nmoge, depth_moge)": [
        "11",
        "comparison_layers"
      ],
      "Alpha from LTX (off = Sapiens2 segmentation, much faster)": [
        "11",
        "use_alpha_mask"
      ],
      "Alpha (LTX) max width": [
        "20",
        "max_width"
      ],
      "Alpha (LTX) seed": [
        "30",
        "noise_seed"
      ]
    }
  },
